# Treat all vendored content as binary (no EOL conversion) so SHA-256
# hashes recorded in vendor/CHECKSUMS.md are stable across platforms.
# Without this, Git on Windows with core.autocrlf=true would rewrite
# LF -> CRLF on checkout, producing different bytes on disk than macOS
# or Linux and breaking scripts/verify-vendor.mjs.
vendor/** -text

# valos-spec.html is generated from the structured sources (risks/, controls/,
# mitigations/, templates/) by `npm run assemble` — never edited by hand. It is
# committed so the README's "open the draft from the branch" workflow keeps
# working, but marking it generated collapses it in GitHub PR diffs (reviewers
# see "Load diff" instead of a few-hundred-line autogenerated change) and drops
# it from language stats. Review the sources, not this file.
valos-spec.html linguist-generated=true
